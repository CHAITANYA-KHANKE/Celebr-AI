# CelebrAI Root Environment Template
# Copy this file to .env and provide your deployment-specific credentials.

# Database URL (SQLite default for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///./celebrai.db

# Google Gemini API Key (Required for live AI-assisted plan generation)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Name
GEMINI_MODEL=gemini-2.5-flash

# Permitted CORS Origins (comma-separated or single origin)
CORS_ORIGINS=http://localhost:5173

# Frontend API base URL (empty string defaults to same-origin proxy in development)
VITE_API_BASE_URL=http://localhost:8000

# Application Environment (development, staging, production)
APP_ENV=development
